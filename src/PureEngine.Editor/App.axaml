<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PureEngine.Editor.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PureEngine.Editor/Resources/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1A1C20" />
    <SolidColorBrush x:Key="EditorViewportBrush" Color="#121419" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#23262C" />
    <SolidColorBrush x:Key="EditorFloatBrush" Color="#2E333B" />
    <SolidColorBrush x:Key="EditorFieldBrush" Color="#333842" />
    <SolidColorBrush x:Key="EditorFieldHoverBrush" Color="#3B4250" />
    <SolidColorBrush x:Key="EditorBorderBrush" Color="#3A3F47" />
    <SolidColorBrush x:Key="EditorBorderStrongBrush" Color="#565E6A" />
    <SolidColorBrush x:Key="EditorTextBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="EditorTextSecondaryBrush" Color="#B8BDC5" />
    <SolidColorBrush x:Key="EditorTextTertiaryBrush" Color="#7D848F" />
    <SolidColorBrush x:Key="EditorAccentBrush" Color="#8B7CF6" />
    <SolidColorBrush x:Key="EditorAccentHoverBrush" Color="#A294FF" />
    <SolidColorBrush x:Key="EditorAccentPressedBrush" Color="#6E5DE0" />
    <SolidColorBrush x:Key="EditorAccentWashBrush" Color="#2E2A4A" />
    <SolidColorBrush x:Key="EditorErrorWashBrush" Color="#3D2A2E" />
    <SolidColorBrush x:Key="EditorErrorTextBrush" Color="#FF9E99" />
    <SolidColorBrush x:Key="EditorInfoBrush" Color="#7AB5F0" />
    <SolidColorBrush x:Key="EditorWarningBrush" Color="#E0B45A" />
    <SolidColorBrush x:Key="EditorErrorBrush" Color="#E06A5A" />
      </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="Button, TextBox, ListBoxItem, MenuItem">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorAccentHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.accent:pressed">
      <Setter Property="Background" Value="{StaticResource EditorAccentPressedBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.accent:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="MenuItem:disabled">
      <Setter Property="Foreground" Value="{StaticResource EditorTextTertiaryBrush}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Foreground" Value="{StaticResource EditorTextSecondaryBrush}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ Path#PART_ChevronPath">
      <Setter Property="Fill" Value="{StaticResource EditorTextSecondaryBrush}" />
    </Style>
    <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
    </Style>
    <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover > ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="MenuItem:open /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
    </Style>
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
    </Style>
    <Style Selector="TreeViewItem:pressed /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot > ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover > ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="TreeViewItem:pressed:selected /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
    </Style>
    <Style Selector="TreeViewItem:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TreeViewItem:disabled /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{StaticResource EditorTextTertiaryBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource EditorFieldBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="CaretBrush" Value="#FFFFFF" />
      <Setter Property="SelectionBrush" Value="{StaticResource EditorAccentBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="#1A1C20" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="TextBox:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    </Style>
    <Style Selector="TextBox:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="ContextMenu MenuItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border#PopupBorder">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ComboBoxItem:disabled /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource EditorTextTertiaryBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource EditorFieldBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBox:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{StaticResource EditorTextSecondaryBrush}" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    </Style>
    <Style Selector="ComboBox:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </Application.Styles>
</Application>

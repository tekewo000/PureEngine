<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="using:PureEngine.Editor"
        x:Class="PureEngine.Editor.LauncherWindow"
        Title="PureEngine Launcher" Width="920" Height="580" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#292929" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="12">
  <Window.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#BBBBBB" /></Style>
    <Style Selector="TextBlock.sectionTitle"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="12,6" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="32" /></Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,10" /><Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>
  <Grid x:Name="LauncherSurface" Margin="28" RowDefinitions="Auto,24,*,Auto">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="PureEngine" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Open Project…" Click="OnOpenProject" AutomationProperties.Name="Open existing project" />
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,24,300">
      <Grid RowDefinitions="Auto,12,*">
        <TextBlock Text="Recent Projects" Classes="sectionTitle" />
        <Border Grid.Row="2" Background="#383838" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="6">
          <Grid>
            <ListBox x:Name="RecentList" Background="Transparent" BorderThickness="0"
                     SelectionMode="Single" DoubleTapped="OnRecentDoubleTapped" KeyDown="OnRecentKeyDown"
                     AutomationProperties.Name="Recent projects">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="editor:RecentProject">
                  <StackPanel Spacing="5" ToolTip.Tip="{Binding ManifestPath}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ManifestPath}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyHistory" Text="最近開いたProjectはありません。" Classes="muted"
                       Margin="12" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                       IsHitTestVisible="False" />
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Column="2" RowDefinitions="Auto,18,Auto,6,Auto,16,Auto,6,Auto,10,Auto,20,Auto,*">
        <TextBlock Text="New Project" Classes="sectionTitle" />
        <TextBlock Grid.Row="2" Text="Project name" />
        <TextBox Grid.Row="4" x:Name="ProjectName" Text="MyGame" AutomationProperties.Name="New project name" />
        <TextBlock Grid.Row="6" Text="Location" />
        <Grid Grid.Row="8" ColumnDefinitions="*,8,Auto">
          <TextBox x:Name="ProjectLocation" AutomationProperties.Name="New project parent folder" />
          <Button Grid.Column="2" Content="Browse…" Click="OnBrowseLocation" AutomationProperties.Name="Choose project parent folder" />
        </Grid>
        <TextBlock Grid.Row="10" x:Name="ProjectDestination" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
        <Button Grid.Row="12" x:Name="CreateProjectButton" Content="Create Project" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Click="OnCreateProject" AutomationProperties.Name="Create new project" />
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="LauncherError" Foreground="#FFB4AB" TextWrapping="Wrap"
               Margin="0,16,0,0" IsVisible="False" AutomationProperties.Name="Launcher status" />
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:PureEngine.Core"
        xmlns:editor="using:PureEngine.Editor"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        x:Class="PureEngine.Editor.MainWindow"
        Title="PureEngine Editor"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        Background="{StaticResource EditorBackgroundBrush}" Foreground="{StaticResource EditorTextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
  <Window.Styles>
    <Style Selector="TreeView#SceneObjects TreeViewItem" x:DataType="editor:HierarchyNode">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TreeView#SceneObjects TreeViewItem.drop-before /template/ Border#PART_LayoutRoot">
      <Setter Property="BoxShadow" Value="inset 0 2 0 0 #4CC2FF" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TreeView#SceneObjects TreeViewItem.drop-after /template/ Border#PART_LayoutRoot">
      <Setter Property="BoxShadow" Value="inset 0 -2 0 0 #4CC2FF" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TreeView#SceneObjects TreeViewItem.drop-as-child /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
    </Style>
    <Style Selector="ListBox#ProjectFiles ListBoxItem">
      <Setter Property="Width" Value="112" />
      <Setter Property="MinHeight" Value="104" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="PathIcon.tileIcon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.rowIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.buttonIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TreeView#ProjectTree TreeViewItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HeaderTemplate">
        <DataTemplate DataType="TreeViewItem">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="rowIcon" Data="{StaticResource Icon.Folder}" AutomationProperties.Name="Folder" />
            <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox#ConsoleList ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox#ConsoleList ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox#ConsoleList ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
    </Style>
    <Style Selector="CheckBox.consoleToggle">
      <Setter Property="Background" Value="{StaticResource EditorFieldBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.consoleToggle:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
    </Style>
    <Style Selector="CheckBox.consoleToggle.info:checked">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorInfoBrush}" />
    </Style>
    <Style Selector="CheckBox.consoleToggle.warning:checked">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorWarningBrush}" />
    </Style>
    <Style Selector="CheckBox.consoleToggle.error:checked">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorErrorBrush}" />
    </Style>
    <Style Selector="CheckBox.consoleToggle.engine:checked">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    </Style>
    <Style Selector="Border.countBadge">
      <Setter Property="Background" Value="{StaticResource EditorFieldBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="20" />
    </Style>
    <Style Selector="Border.countBadge > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.levelBadge">
      <Setter Property="Background" Value="{StaticResource EditorFieldBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.sourceBadge">
      <Setter Property="Background" Value="{StaticResource EditorFieldBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.metaPill">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.consoleCard">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.rowAccent">
      <Setter Property="Width" Value="3" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabControl.editorTabs">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="28,*">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="0,0,0,-1" Height="29" VerticalAlignment="Top" ZIndex="1" />
            <Border Grid.Row="1" Background="{StaticResource EditorSurfaceBrush}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="0,6,6,6" Margin="0,-1,0,0" UseLayoutRounding="False">
              <ContentPresenter Name="PART_SelectedContentHost"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl.editorTabs TabItem.paneTab">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Width" Value="112" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="29" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Path Name="TabFill" Fill="{TemplateBinding Background}" />
            <Path Name="TabOutline" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"
                  UseLayoutRounding="False" />
            <TextBlock Text="{TemplateBinding Header}" Margin="12,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl.editorTabs TabItem.paneTab /template/ Path#TabFill">
      <Setter Property="Data" Value="M0,29 L0,28 Q6,28 6,22 L6,6 Q6,0.75 12,0.75 L100,0.75 Q106,0.75 106,6 L106,22 Q106,28 112,28 L112,29 Z" />
    </Style>
    <Style Selector="TabControl.editorTabs TabItem.paneTab /template/ Path#TabOutline">
      <Setter Property="Data" Value="M0,27.75 Q6,27.75 6,22 L6,6 Q6,0.75 12,0.75 L100,0.75 Q106,0.75 106,6 L106,22 Q106,27.75 112,27.75" />
    </Style>
    <Style Selector="TabControl.editorTabs TabItem.paneTab.first /template/ Path#TabFill">
      <Setter Property="Data" Value="M0.75,29 L0.75,6 Q0.75,0.75 6,0.75 L100,0.75 Q106,0.75 106,6 L106,22 Q106,28 112,28 L112,29 Z" />
    </Style>
    <Style Selector="TabControl.editorTabs TabItem.paneTab.first /template/ Path#TabOutline">
      <Setter Property="Data" Value="M0.75,29 L0.75,6 Q0.75,0.75 6,0.75 L100,0.75 Q106,0.75 106,6 L106,22 Q106,27.75 112,27.75" />
    </Style>
    <Style Selector="TabControl.editorTabs TabItem.paneTab:selected">
      <Setter Property="Background" Value="{StaticResource EditorSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="TabControl.editorTabs:focus-within">
      <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    </Style>
    <Style Selector="TabControl.editorTabs:focus-within TabItem.paneTab:selected">
      <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource EditorTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.objectId">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.kindBadge">
      <Setter Property="Background" Value="{StaticResource EditorFieldBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.startupPill">
      <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Separator.divider">
      <Setter Property="Background" Value="{StaticResource EditorBorderBrush}" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="Border.componentCard">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.memberType">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.cardMeta">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextTertiaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.errorBadge">
      <Setter Property="Background" Value="{StaticResource EditorErrorWashBrush}" />
      <Setter Property="Foreground" Value="#FF9E99" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.inspectorField">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{StaticResource EditorFieldBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="CaretBrush" Value="#FFFFFF" />
      <Setter Property="SelectionBrush" Value="{StaticResource EditorAccentBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="#1A1A1A" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.inspectorField:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
    </Style>
    <Style Selector="TextBox.inspectorField:focus">
      <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
    </Style>
    <Style Selector="TextBox.inspectorField:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBox.inspectorField.numericField">
      <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{StaticResource EditorFieldBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MaxDropDownHeight" Value="240" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo:focus">
      <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource EditorFieldHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo:focus-visible /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource EditorAccentWashBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorAccentBrush}" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo:focus-visible /template/ Border#HighlightBackground">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{StaticResource EditorTextSecondaryBrush}" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo:pointerover /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo:focus-visible /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo /template/ ContentControl#ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    </Style>
    <Style Selector="ComboBox.inspectorCombo /template/ TextBlock#PlaceholderTextBlock">
      <Setter Property="Foreground" Value="{StaticResource EditorTextTertiaryBrush}" />
    </Style>
    <Style Selector="Grid.inspectorRow">
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Grid.inspectorRow:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
    </Style>
    <Style Selector="CheckBox.inspectorCheck">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource EditorTextBrush}" />
    </Style>
    <Style Selector="Button.collapseToggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource EditorAccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.collapseToggle:pointerover">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.collapseToggle:pressed">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.unsupportedBadge">
      <Setter Property="Background" Value="{StaticResource EditorFloatBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Border.pane">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.viewportFrame">
      <Setter Property="Background" Value="{StaticResource EditorViewportBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="8" />
    </Style>
    <Style Selector="Rectangle.columnDivider">
      <Setter Property="Fill" Value="{StaticResource EditorBorderBrush}" />
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="6,4" />
    </Style>
    <Style Selector="GridSplitter.paneSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter.paneSplitter:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="GridSplitter.paneSplitter:focus-visible">
      <Setter Property="Background" Value="{StaticResource EditorAccentBrush}" />
    </Style>
  </Window.Styles>

  <Grid x:Name="EditorSurface" RowDefinitions="48,*,26" Margin="8,0">
    <Grid ColumnDefinitions="220,*,240" Margin="10,0">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="PureEngine" FontWeight="SemiBold" />
        <Menu Background="Transparent" VerticalAlignment="Center">
          <MenuItem Header="File">
            <MenuItem x:Name="CloseProjectMenu" Header="Return to Launcher" InputGesture="Ctrl+Shift+O" Click="OnCloseProject" />
            <Separator />
            <MenuItem x:Name="NewSceneMenu" Header="New Scene" InputGesture="Ctrl+N" Click="OnNewScene" />
            <MenuItem x:Name="OpenSceneMenu" Header="Open Scene…" InputGesture="Ctrl+O" Click="OnOpenScene" />
            <MenuItem x:Name="SaveSceneMenu" Header="Save Scene" InputGesture="Ctrl+S" Click="OnSaveScene" />
            <MenuItem x:Name="SaveSceneAsMenu" Header="Save Scene As…" InputGesture="Ctrl+Shift+S" Click="OnSaveSceneAs" />
            <MenuItem x:Name="StartupSceneMenu" Header="Set Current Scene as Startup" Click="OnSetStartupScene" IsEnabled="False" />
          </MenuItem>
          <MenuItem Header="Edit" IsEnabled="False" />
          <MenuItem Header="View" IsEnabled="False" />
        </Menu>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <Button x:Name="PlayButton" Classes="accent" MinWidth="96" Click="OnPlayClicked" AutomationProperties.Name="Play">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="buttonIcon" Data="{StaticResource Icon.Play}" />
            <TextBlock Text="Play" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="StopButton" MinWidth="96" Click="OnStopClicked" IsEnabled="False" AutomationProperties.Name="Stop">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="buttonIcon" Data="{StaticResource Icon.Stop}" />
            <TextBlock Text="Stop" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="592" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="472" MinWidth="160" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="CenterGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="240" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="344" MinWidth="140" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="180" />
          <RowDefinition Height="8" />
          <RowDefinition Height="328" MinHeight="80" />
        </Grid.RowDefinitions>
        <GridSplitter Grid.Column="1" Classes="paneSplitter" ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Cursor="SizeWestEast" AutomationProperties.Name="Resize Stuffs pane" />
        <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Classes="paneSplitter" ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Cursor="SizeNorthSouth" AutomationProperties.Name="Resize Assets and Console pane" />
        <Border Grid.Column="2" Classes="pane">
          <TabControl Classes="editorTabs" SelectedIndex="0" PointerPressed="OnPanePointerPressed">
            <TabItem Classes="paneTab first" Header="Stuffs" AutomationProperties.Name="Stuffs">
              <Grid x:Name="SceneSurface" RowDefinitions="Auto,*" Background="Transparent" DragDrop.AllowDrop="True">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem x:Name="AddObjectMenuItem" Header="Add Empty" Click="OnAddObject" />
                    <MenuItem x:Name="AddUiMenuItem" Header="UI">
                      <MenuItem x:Name="AddUiImageMenuItem" Header="Image" Click="OnAddUiImage" />
                      <MenuItem x:Name="AddUiButtonMenuItem" Header="Button" Click="OnAddUiButton" />
                      <MenuItem x:Name="AddUiTextMenuItem" Header="Text" Click="OnAddUiText" />
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="SavePrefabMenuItem" Header="Save as Prefab…" Click="OnSavePrefab"
                              IsEnabled="False" />
                    <MenuItem x:Name="DeleteObjectMenuItem" Header="Delete" Click="OnDeleteObject"
                              InputGesture="Delete" IsEnabled="False" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock x:Name="StuffsContext" IsVisible="False" Margin="12,8,12,0"
                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                <TreeView x:Name="SceneObjects" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="8"
                          SelectionMode="Single" AutomationProperties.Name="Stuffs objects"
                          DragDrop.AllowDrop="True"
                          KeyDown="OnSceneKeyDown" SelectionChanged="OnObjectSelected">
                  <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="editor:HierarchyNode" ItemsSource="{Binding Children}">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <PathIcon Classes="rowIcon" Data="{StaticResource Icon.Hierarchy}"
                                  AutomationProperties.Name="SceneObject" />
                        <TextBlock Grid.Column="1" Text="{Binding Ref.Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Ref.Name}" />
                      </Grid>
                    </TreeDataTemplate>
                  </TreeView.DataTemplates>
                </TreeView>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
        <Border x:Name="SceneViewPane" Classes="pane">
          <TabControl x:Name="ViewportTabs" Classes="editorTabs" SelectedIndex="0" PointerPressed="OnPanePointerPressed">
            <TabItem x:Name="SceneViewTab" Classes="paneTab first" Header="Scene View" AutomationProperties.Name="Scene View">
              <Border Classes="viewportFrame">
                <Grid x:Name="SceneViewHost"><Grid x:Name="SceneViewport" /></Grid>
              </Border>
            </TabItem>
            <TabItem Classes="paneTab" Header="Game" AutomationProperties.Name="Game">
              <Grid>
                <Grid x:Name="GameViewport" />
                <TextBlock x:Name="GamePlaceholder" Classes="hint" Text="Press Play to show the game."
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           AutomationProperties.Name="Game placeholder" />
              </Grid>
            </TabItem>
            <TabItem x:Name="PrefabEditorTab" Classes="paneTab" Header="Prefab Editor" AutomationProperties.Name="Prefab Editor" IsVisible="False">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="12,8">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PrefabEditorTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PrefabEditorPath" Classes="hint" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button x:Name="SavePrefabEditorButton" Grid.Column="1" Content="Save" Click="OnSavePrefabEditor"
                          VerticalAlignment="Center" AutomationProperties.Name="Save Prefab" ToolTip.Tip="Save prefab (Ctrl+S)" />
                  <Button Grid.Column="2" Content="Close" Click="OnClosePrefabEditor" VerticalAlignment="Center"
                          AutomationProperties.Name="Close Prefab Editor" />
                </Grid>
                <Grid x:Name="PrefabViewHost" Grid.Row="1" />
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="pane">
          <TabControl Classes="editorTabs" SelectedIndex="0" PointerPressed="OnPanePointerPressed">
            <TabItem x:Name="ProjectTab" Classes="paneTab first" Header="Project" AutomationProperties.Name="Project">
              <Grid ColumnDefinitions="180,8,*" Margin="8">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="FOLDERS" Classes="columnHeader" Margin="8,2,0,0" />
                  <Separator Grid.Row="1" Classes="divider" Margin="0,6" />
                  <TreeView Grid.Row="2" x:Name="ProjectTree" Background="Transparent" BorderThickness="0"
                            SelectionMode="Single" DragDrop.AllowDrop="True"
                            AutomationProperties.Name="Project folders"
                            SelectionChanged="OnProjectTreeSelectionChanged"
                            ContextRequested="OnProjectTreeContextRequested"
                            PointerPressed="OnProjectTreePointerPressed">
                    <TreeView.ContextMenu>
                      <ContextMenu>
                        <MenuItem x:Name="TreeCreateFolderMenu" Header="Create Folder" Click="OnExplorerCreateFolder" />
                        <MenuItem x:Name="TreeCreateCSharpMenu" Header="Create C#" Click="OnExplorerCreateCSharp" />
                        <MenuItem x:Name="TreeCreateSceneMenu" Header="Create Scene" Click="OnExplorerCreateScene" />
                        <MenuItem x:Name="TreeCreateDataAssetMenu" Header="Create Data Asset" />
                        <MenuItem Header="Import Image…" Click="OnImportImage" AutomationProperties.Name="Import Image" />
                        <Separator />
                        <MenuItem x:Name="TreeRenameMenu" Header="Rename" Click="OnExplorerRename" />
                        <MenuItem x:Name="TreeDeleteMenu" Header="Delete" Click="OnExplorerDelete" />
                        <Separator />
                        <MenuItem Header="Refresh" Click="OnExplorerRefresh" />
                      </ContextMenu>
                    </TreeView.ContextMenu>
                  </TreeView>
                </Grid>
                <GridSplitter Grid.Column="1" Classes="paneSplitter" ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Cursor="SizeWestEast" AutomationProperties.Name="Resize Project tree" />
                <Grid Grid.Column="2" RowDefinitions="Auto,*">
                  <TextBlock x:Name="ProjectFilesCount" Classes="muted" FontSize="11" Margin="8,2,0,6" />
                  <ListBox Grid.Row="1" x:Name="ProjectFiles" Background="Transparent" BorderThickness="0"
                           SelectionMode="Single" DragDrop.AllowDrop="True"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           AutomationProperties.Name="Project files"
                           DoubleTapped="OnProjectFilesDoubleTapped" KeyDown="OnProjectFilesKeyDown"
                           SelectionChanged="OnProjectFilesSelectionChanged"
                           ContextRequested="OnProjectFilesContextRequested"
                           PointerPressed="OnProjectFilesPointerPressed">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem x:Name="FilesOpenMenu" Header="Open" Click="OnExplorerOpen" />
                      <MenuItem x:Name="FilesPlaceMenu" Header="Place in Scene" Click="OnExplorerPlacePrefab" />
                      <MenuItem x:Name="FilesStartupMenu" Header="Set as Startup Scene" Click="OnSetStartupScene" />
                      <Separator />
                      <MenuItem x:Name="FilesCreateFolderMenu" Header="Create Folder" Click="OnExplorerCreateFolder" />
                      <MenuItem x:Name="FilesCreateCSharpMenu" Header="Create C#" Click="OnExplorerCreateCSharp" />
                      <MenuItem x:Name="FilesCreateSceneMenu" Header="Create Scene" Click="OnExplorerCreateScene" />
                      <MenuItem x:Name="FilesCreateDataAssetMenu" Header="Create Data Asset" />
                      <MenuItem Header="Import Image…" Click="OnImportImage" AutomationProperties.Name="Import Image" />
                      <Separator />
                      <MenuItem x:Name="FilesRenameMenu" Header="Rename" Click="OnExplorerRename" />
                      <MenuItem x:Name="FilesDeleteMenu" Header="Delete" Click="OnExplorerDelete" />
                      <Separator />
                      <MenuItem Header="Refresh" Click="OnExplorerRefresh" />
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="editor:ProjectExplorerEntry">
                      <Border BorderBrush="{Binding TileBorderBrush}" BorderThickness="1" CornerRadius="6"
                              Background="{StaticResource EditorFloatBrush}" Padding="8,10,8,8" ToolTip.Tip="{Binding ToolTip}">
                        <StackPanel Spacing="6" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                          <Panel Height="36" AutomationProperties.Name="{Binding KindLabel}">
                            <PathIcon Classes="tileIcon" Data="{StaticResource Icon.Folder}" IsVisible="{Binding IsFolder}" />
                            <PathIcon Classes="tileIcon" Data="{StaticResource Icon.Scene}" IsVisible="{Binding IsScene}" />
                            <PathIcon Classes="tileIcon" Data="{StaticResource Icon.DataAsset}" IsVisible="{Binding IsDataAsset}" />
                            <PathIcon Classes="tileIcon" Data="{StaticResource Icon.Image}" IsVisible="{Binding IsImageFile}" />
                            <PathIcon Classes="tileIcon" Data="{StaticResource Icon.CSharp}" IsVisible="{Binding IsCSharpFile}" />
                            <PathIcon Classes="tileIcon" Data="{StaticResource Icon.Prefab}" IsVisible="{Binding IsPrefab}" />
                            <PathIcon Classes="tileIcon" Data="{StaticResource Icon.File}" IsVisible="{Binding IsPlainFile}" />
                          </Panel>
                          <TextBlock Text="{Binding DisplayName}" MaxLines="1"
                                     TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10"
                                     TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                     IsVisible="{Binding HasDetail}" />
                          <Border Classes="startupPill" IsVisible="{Binding IsStartup}" HorizontalAlignment="Center">
                            <TextBlock Text="Startup" FontSize="10" Foreground="#1A1C20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                          </Border>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Classes="paneTab" Header="Console" AutomationProperties.Name="Console">
              <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <CheckBox x:Name="ConsoleInfoFilter" Classes="consoleToggle info" IsChecked="True"
                            AutomationProperties.Name="Console info filter" VerticalAlignment="Center" Margin="0,0,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="Info" VerticalAlignment="Center" />
                      <Border Classes="countBadge">
                        <TextBlock x:Name="ConsoleInfoCount" Classes="muted" Text="0" VerticalAlignment="Center" AutomationProperties.Name="Console info count" />
                      </Border>
                    </StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="ConsoleWarningFilter" Classes="consoleToggle warning" IsChecked="True"
                            AutomationProperties.Name="Console warning filter" VerticalAlignment="Center" Margin="0,0,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="Warning" VerticalAlignment="Center" />
                      <Border Classes="countBadge">
                        <TextBlock x:Name="ConsoleWarningCount" Classes="muted" Text="0" VerticalAlignment="Center" AutomationProperties.Name="Console warning count" />
                      </Border>
                    </StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="ConsoleErrorFilter" Classes="consoleToggle error" IsChecked="True"
                            AutomationProperties.Name="Console error filter" VerticalAlignment="Center" Margin="0,0,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="Error" VerticalAlignment="Center" />
                      <Border Classes="countBadge">
                        <TextBlock x:Name="ConsoleErrorCount" Classes="muted" Text="0" VerticalAlignment="Center" AutomationProperties.Name="Console error count" />
                      </Border>
                    </StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="ConsoleEngineFilter" Classes="consoleToggle engine" IsChecked="True"
                            AutomationProperties.Name="Console engine filter" VerticalAlignment="Center" Margin="0,0,8,4"
                            ToolTip.Tip="Show engine logs (Info / Warning / Error)">
                    <TextBlock Text="Engine" VerticalAlignment="Center" />
                  </CheckBox>
                  <PathIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,4" Foreground="{StaticResource EditorTextSecondaryBrush}" AutomationProperties.Name="Console search icon" />
                  <TextBox x:Name="ConsoleSearch" Width="160" Margin="0,0,8,4" PlaceholderText="Search…" AutomationProperties.Name="Console search" VerticalAlignment="Center" />
                  <Button x:Name="ConsoleClear" Click="OnConsoleClear" AutomationProperties.Name="Console clear" VerticalAlignment="Center" Margin="0,0,8,4" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="buttonIcon" Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
                      <TextBlock Text="Clear" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <CheckBox x:Name="ConsoleClearOnPlay" Content="Clear on Play" IsChecked="True" AutomationProperties.Name="Console clear on play" VerticalAlignment="Center" Margin="0,0,8,4" ToolTip.Tip="Clear history when Play starts" />
                  <Border Classes="metaPill" Margin="0,0,0,4">
                    <TextBlock x:Name="ConsoleDropped" Classes="muted" VerticalAlignment="Center" AutomationProperties.Name="Console dropped" FontSize="11" />
                  </Border>
                </WrapPanel>
                <StackPanel Grid.Row="1" Margin="8,2,8,0" Spacing="2">
                  <Grid ColumnDefinitions="4,82,78,76,*">
                    <TextBlock Grid.Column="1" Text="TIME" Classes="columnHeader" FontSize="10" />
                    <TextBlock Grid.Column="2" Text="LEVEL" Classes="columnHeader" FontSize="10" />
                    <TextBlock Grid.Column="3" Text="SOURCE" Classes="columnHeader" FontSize="10" />
                    <TextBlock Grid.Column="4" Text="MESSAGE" Classes="columnHeader" FontSize="10" />
                  </Grid>
                  <Separator Classes="divider" Margin="0,0" />
                </StackPanel>
                <ListBox Grid.Row="2" x:Name="ConsoleList" Margin="0,2,0,4" Background="Transparent" BorderThickness="0"
                         SelectionMode="Single" SelectionChanged="OnConsoleSelectionChanged"
                         AutomationProperties.Name="Console list">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="editor:ConsoleRow">
                      <Grid ColumnDefinitions="4,82,78,76,*" VerticalAlignment="Center">
                        <Border Classes="rowAccent" Background="{Binding LevelAccent}" />
                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Classes="muted" FontSize="11" FontFamily="Consolas,Menlo,monospace" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Classes="levelBadge" Background="{Binding LevelBadgeBackground}" BorderBrush="{Binding LevelBadgeBorder}">
                          <TextBlock Text="{Binding LevelText}" Foreground="{Binding LevelBadgeForeground}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="3" Classes="sourceBadge" Background="{Binding SourceBadgeBackground}" BorderBrush="{Binding SourceBadgeBorder}">
                          <TextBlock Text="{Binding SourceText}" Foreground="{Binding SourceBadgeForeground}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="4" Text="{Binding Head}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="{Binding Head}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" RowDefinitions="Auto,80">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,2">
                    <TextBlock Text="Details" Classes="columnHeader" />
                    <TextBlock Text="Selected log" Classes="muted" FontSize="10" />
                  </StackPanel>
                  <Border Grid.Row="1" Classes="consoleCard" Padding="0" Margin="0,0,8,0">
                    <TextBox x:Name="ConsoleDetail" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0" PlaceholderText="Select a log to show details"
                             AutomationProperties.Name="Console detail" />
                  </Border>
                  <Button Grid.Row="1" Grid.Column="1" x:Name="ConsoleCopy" Content="Copy" Click="OnConsoleCopy"
                          VerticalAlignment="Top" Margin="8,0,0,0" AutomationProperties.Name="Console copy" ToolTip.Tip="Copy details to clipboard" />
                </Grid>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
      <GridSplitter Grid.Column="1" Classes="paneSplitter" ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Cursor="SizeWestEast" AutomationProperties.Name="Resize Inspector pane" />
      <Border Grid.Column="2" Classes="pane">
        <TabControl x:Name="InspectorPane" Classes="editorTabs" SelectedIndex="0"
                    PointerPressed="OnPanePointerPressed" DragDrop.AllowDrop="True">
          <TabItem Classes="paneTab first" Header="Inspector" AutomationProperties.Name="Inspector">
            <ScrollViewer Margin="8">
             <StackPanel Spacing="6">
              <StackPanel x:Name="ObjectInspector" IsVisible="False" Spacing="6">
                <TextBlock Text="NAME" Classes="caption" Margin="0,0,0,-2" />
                <TextBox x:Name="ObjectName" Classes="inspectorField" PlaceholderText="Object name…" AutomationProperties.Name="Object name" />
                <TextBlock x:Name="NameError" Text="Enter a name." Foreground="#FF9E99"
                           TextWrapping="Wrap" IsVisible="False" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2,0,0">
                  <TextBlock Text="ID" Classes="caption" />
                  <TextBlock x:Name="ObjectId" Classes="objectId" MaxLines="1" Grid.Column="1"
                             HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </Grid>
                <StackPanel x:Name="AttachedClasses" IsVisible="False" Spacing="8" Margin="0,4,0,0">
                  <Separator Classes="divider" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="ComponentsHeader" Text="Components" Classes="sectionHeader"
                               VerticalAlignment="Center" />
                    <Button x:Name="AddComponentButton" Content="Add Component" Grid.Column="1"
                            FontSize="11" Padding="8,2" VerticalAlignment="Center"
                            AutomationProperties.Name="Add Component" Click="OnAddComponent" />
                    <TextBlock x:Name="ComponentsError" Classes="errorBadge" Grid.Column="2" IsVisible="False" />
                  </Grid>
                  <StackPanel x:Name="ComponentEditors" Spacing="12" />
                </StackPanel>
                <TextBlock x:Name="NoComponentsHint" Classes="hint" IsVisible="False"
                           Text="No components — press Add Component or drag a .cs file from Project to attach." />
                <TextBlock x:Name="AttachError" Foreground="#FF9E99" TextWrapping="Wrap" IsVisible="False" />
              </StackPanel>
              <StackPanel x:Name="DataAssetInspector" IsVisible="False" Spacing="6">
                <TextBlock Text="DATA ASSET" Classes="caption" Margin="0,0,0,-2" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock x:Name="DataAssetTitle" Classes="sectionHeader" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="DataAssetInvalid" Classes="errorBadge" Grid.Column="1" IsVisible="False"
                             VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2,0,0">
                  <TextBlock Text="ID" Classes="caption" />
                  <TextBlock x:Name="DataAssetId" Classes="objectId" MaxLines="1" Grid.Column="1"
                             HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2,0,0">
                  <TextBlock Text="Type" Classes="caption" />
                  <TextBlock x:Name="DataAssetType" Classes="objectId" MaxLines="1" Grid.Column="1"
                             HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Button x:Name="SaveDataAssetButton" Content="Save Data Asset" FontSize="11" Padding="8,2"
                        HorizontalAlignment="Left" AutomationProperties.Name="Save Data Asset" Click="OnSaveDataAsset" />
                <TextBlock x:Name="DataAssetError" Foreground="#FF9E99" TextWrapping="Wrap" IsVisible="False" />
                <StackPanel x:Name="DataAssetEditors" Spacing="12" />
              </StackPanel>
             </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource EditorSurfaceBrush}" BorderBrush="{StaticResource EditorBorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
        <TextBlock x:Name="FileStatus" Classes="muted" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" AutomationProperties.Name="Scene file status" />
        <Rectangle Grid.Column="1" Classes="columnDivider" />
        <TextBlock Grid.Column="2" x:Name="SelectionStatus" Classes="muted" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" AutomationProperties.Name="Selection status" />
        <TextBlock Grid.Column="3" x:Name="SceneZoomStatus" Classes="muted" VerticalAlignment="Center"
                   AutomationProperties.Name="Scene zoom status" />
      </Grid>
    </Border>
  </Grid>
</Window>

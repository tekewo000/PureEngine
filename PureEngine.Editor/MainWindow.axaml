<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:PureEngine.Core"
        x:Class="PureEngine.Editor.MainWindow"
        Title="PureEngine Editor"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        Background="#292929" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
  <Window.Styles>
    <Style Selector="ListBox#SceneObjects ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TabControl.editorTabs">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="BorderBrush" Value="#BBBBBB" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="28,*">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="0,0,0,-1" Height="29" VerticalAlignment="Top" ZIndex="1" />
            <Border Grid.Row="1" Background="#383838" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                    CornerRadius="0,6,6,6" Margin="0,-1,0,0" UseLayoutRounding="False">
              <ContentPresenter Name="PART_SelectedContentHost"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl.editorTabs TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Width" Value="112" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="29" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Foreground" Value="#D5D5D5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Path Name="TabFill" Fill="{TemplateBinding Background}" />
            <Path Name="TabOutline" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5"
                  UseLayoutRounding="False" />
            <TextBlock Text="{TemplateBinding Header}" Margin="12,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl.editorTabs TabItem /template/ Path#TabFill">
      <Setter Property="Data" Value="M0,29 L0,28 Q6,28 6,22 L6,6 Q6,0.75 12,0.75 L100,0.75 Q106,0.75 106,6 L106,22 Q106,28 112,28 L112,29 Z" />
    </Style>
    <Style Selector="TabControl.editorTabs TabItem /template/ Path#TabOutline">
      <Setter Property="Data" Value="M0,27.75 Q6,27.75 6,22 L6,6 Q6,0.75 12,0.75 L100,0.75 Q106,0.75 106,6 L106,22 Q106,27.75 112,27.75" />
    </Style>
    <Style Selector="TabControl.editorTabs TabItem.first /template/ Path#TabFill">
      <Setter Property="Data" Value="M0.75,29 L0.75,6 Q0.75,0.75 6,0.75 L100,0.75 Q106,0.75 106,6 L106,22 Q106,28 112,28 L112,29 Z" />
    </Style>
    <Style Selector="TabControl.editorTabs TabItem.first /template/ Path#TabOutline">
      <Setter Property="Data" Value="M0.75,29 L0.75,6 Q0.75,0.75 6,0.75 L100,0.75 Q106,0.75 106,6 L106,22 Q106,27.75 112,27.75" />
    </Style>
    <Style Selector="TabControl.editorTabs TabItem:selected">
      <Setter Property="Background" Value="#383838" />
      <Setter Property="BorderBrush" Value="#BBBBBB" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="TabControl.editorTabs:focus-within">
      <Setter Property="BorderBrush" Value="#B2A0E0" />
    </Style>
    <Style Selector="TabControl.editorTabs:focus-within TabItem:selected">
      <Setter Property="BorderBrush" Value="#B2A0E0" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#BBBBBB" />
    </Style>
    <Style Selector="Border.pane">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="GridSplitter.paneSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="2" /></ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter.paneSplitter:pointerover">
      <Setter Property="Background" Value="#555555" />
    </Style>
    <Style Selector="GridSplitter.paneSplitter:focus-visible">
      <Setter Property="Background" Value="#B2A0E0" />
    </Style>
  </Window.Styles>

  <!-- Pane tabs are interactive; the main toolbar remains a visual placeholder. -->
  <Grid RowDefinitions="48,*,26" Margin="8,0">
    <Grid ColumnDefinitions="220,*,240" Margin="10,0">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="PureEngine" FontWeight="SemiBold" />
        <TextBlock Text="File" Classes="muted" />
        <TextBlock Text="Edit" Classes="muted" />
        <TextBlock Text="View" Classes="muted" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="22">
        <Path Data="M 0,0 L 0,12 L 9,6 Z" Fill="#B8AFF1" Width="9" Height="12" VerticalAlignment="Center" />
        <TextBlock Text="Preview" Classes="muted" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="208" MinWidth="140" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="240" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="256" MinWidth="160" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="180" />
        <RowDefinition Height="8" />
        <RowDefinition Height="164" MinHeight="80" />
      </Grid.RowDefinitions>
      <GridSplitter Grid.Column="1" Classes="paneSplitter" ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Cursor="SizeWestEast" AutomationProperties.Name="Resize Stuffs pane" />
      <GridSplitter Grid.Column="3" Grid.RowSpan="3" Classes="paneSplitter" ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Cursor="SizeWestEast" AutomationProperties.Name="Resize Inspector pane" />
      <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Classes="paneSplitter" ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Cursor="SizeNorthSouth" AutomationProperties.Name="Resize Assets and Console pane" />
      <Border Classes="pane">
        <TabControl Classes="editorTabs" SelectedIndex="0" PointerPressed="OnPanePointerPressed">
          <TabItem Classes="first" Header="Stuffs" AutomationProperties.Name="Stuffs">
            <Grid x:Name="SceneSurface" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Add Empty" Click="OnAddObject" />
                  <Separator />
                  <MenuItem x:Name="DeleteObjectMenuItem" Header="Delete" Click="OnDeleteObject"
                            InputGesture="Delete" IsEnabled="False" />
                </ContextMenu>
              </Grid.ContextMenu>
              <ListBox x:Name="SceneObjects" Background="Transparent" BorderThickness="0" Margin="8"
                       SelectionMode="Single" AutomationProperties.Name="Stuffs objects"
                       KeyDown="OnSceneKeyDown">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="core:SceneObject">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
      <Border Grid.Column="2" Classes="pane">
        <TabControl Classes="editorTabs" SelectedIndex="0" PointerPressed="OnPanePointerPressed">
          <TabItem Classes="first" Header="Scene View" AutomationProperties.Name="Scene View"><Grid /></TabItem>
          <TabItem Header="Game" AutomationProperties.Name="Game"><Grid /></TabItem>
        </TabControl>
      </Border>
      <Border Grid.Column="4" Grid.RowSpan="3" Classes="pane">
        <TabControl Classes="editorTabs" SelectedIndex="0" PointerPressed="OnPanePointerPressed">
          <TabItem Classes="first" Header="Inspector" AutomationProperties.Name="Inspector">
            <Grid Margin="12">
              <StackPanel x:Name="ObjectInspector" IsVisible="False" Spacing="8">
                <TextBlock Text="Name" />
                <TextBox x:Name="ObjectName" AutomationProperties.Name="Object name" FontSize="12" />
                <TextBlock x:Name="NameError" Text="名前を入力してください。" Foreground="#FFB4AB"
                           TextWrapping="Wrap" IsVisible="False" />
                <TextBlock Text="Object ID" Classes="muted" Margin="0,12,0,0" />
                <TextBlock x:Name="ObjectId" TextWrapping="Wrap" FontSize="11" Classes="muted" />
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
      <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="pane">
        <TabControl Classes="editorTabs" SelectedIndex="0" PointerPressed="OnPanePointerPressed">
          <TabItem Classes="first" Header="Assets" AutomationProperties.Name="Assets"><Grid /></TabItem>
          <TabItem Header="Console" AutomationProperties.Name="Console"><Grid /></TabItem>
        </TabControl>
      </Border>
    </Grid>
  </Grid>
</Window>
